# Fireworks AI API Key (Required for LLM inferences)
FIREWORKS_API_KEY=your_fireworks_api_key_here

# Database Configurations (These match docker-compose defaults)
DATABASE_URL=postgresql://postgres:password@localhost:5432/neuroflow
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Demo Mode: Set to 'true' to bypass all external API calls during a live demo.
# Streams a pre-recorded advisory via WebSocket so the app works with zero external dependencies.
DEMO_MODE=false
